# wrangler dev がローカルで読み込む Workers 用シークレット。
# 本番は `wrangler secret put <NAME>` で設定する。
#
# DATABASE_URL はここには不要。Workers 本体は Hyperdrive バインディング
# （wrangler.jsonc の hyperdrive）経由で Neon に接続するため（issue #22）。
# drizzle-kit CLI 用の直接接続文字列は .env（.env.example 参照）で管理する。
#
# wrangler.jsonc の hyperdrive[0].id はプレースホルダーのままだと
# `wrangler hyperdrive create` で実際の id に置き換えるまで `wrangler dev` /
# `wrangler deploy` の両方が失敗する。`wrangler dev`（ローカル）だけ先に
# 動かしたい場合は、以下の変数に Neon の直接接続文字列を設定すると
# Hyperdrive の設定を Cloudflare 側へ問い合わせずローカルから直接つなぎに
# 行く（本番デプロイには実際の id への置き換えが別途必要。
# docs/hyperdrive-migration.md 参照）。
WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# BetterAuth（docs/proposal.md §7・§7.2）
# openssl rand -base64 32 などで生成する
BETTER_AUTH_SECRET=
# ローカルは http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console で OAuth クライアントを作成して取得する
# 承認済みリダイレクト URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
